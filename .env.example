# ProtoScore Oncology V2.1 — Environment Configuration
#
# Copy this file to `.env` and fill in keys only for the providers you plan
# to use. The UI dropdown selects the active provider at runtime; missing
# keys produce a descriptive error rather than a crash.
#
# Ollama (Local) requires NO key — install from https://ollama.com and run
# `ollama serve`. The recommended model auto-pulls on first run.

# OpenAI (Cloud) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Cloud) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
